# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto.
# `.env.local` não é versionado — nenhuma credencial real entra no repositório.
#
# Onde achar: Firebase Console → Project settings (engrenagem) → General →
# Your apps → app Web → SDK setup and configuration → Config.
# As seis variáveis abaixo são obrigatórias: faltando uma, a aplicação falha
# nomeando exatamente qual.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional. Endereço público do site, usado no canonical, no Open Graph, no
# sitemap e no robots. Sem ela, vale https://kercia-keylla.vercel.app.
NEXT_PUBLIC_SITE_URL=
