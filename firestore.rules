rules_version = '2';

// Ruleset COMPLETO do projeto Firebase `meu-portfolio-377aa`.
//
// ATENÇÃO: este projeto é compartilhado por dois sites — o portfólio do João
// (posts, projects, games, books, site, playing, figma, uses, guestbook) e o
// site da Keylla (publicacoes, formacoes). O Firestore tem UM ruleset por
// projeto: publicar este arquivo substitui as regras dos DOIS sites. Ao mexer
// nas regras do portfólio, reflita a mudança aqui — e vice-versa.
//
// Ordem importa: os blocos específicos vêm antes do `match /{document=**}`
// que nega o resto (defense in depth).
//
// ── Como liberar a Keylla para publicar ──────────────────────────────────────
// 1. Firebase Console → Authentication → Users → Add user: e-mail e senha dela
//    (não existe cadastro aberto; a usuária é criada à mão).
// 2. Copiar o "User UID" da linha criada.
// 3. Trocar COLE_AQUI_O_UID_DA_KEYLLA, na função `autoras()`, por esse uid.
// 4. Publicar: `firebase deploy --only firestore:rules` na raiz de
//    portfolio-keylla, ou colar no Console → Firestore Database → Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // ═════════════════════════════════════════════════════════════════════════
    // PORTFÓLIO DO JOÃO
    // ═════════════════════════════════════════════════════════════════════════

    // Verifica se o request é do admin autenticado.
    // Mesmo valor de NEXT_PUBLIC_ADMIN_UID no portfólio.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'm9GLhNQbNZRbwFT3l6M8XiJSIpF3';
    }

    // ─────────────────────────────────────────────────────────
    // POSTS
    //   Leitura pública: só posts com `published == true`.
    //   Admin: leitura total + escrita.
    // ─────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // PROJECTS
    //   Leitura pública total (sem flag de "published" no schema).
    //   Admin: escrita.
    // ─────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // GAMES
    //   Leitura pública: só games com `published == true`.
    //   Admin: leitura total + escrita.
    // ─────────────────────────────────────────────────────────
    match /games/{gameId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // BOOKS
    //   Leitura pública: só books com `published == true`.
    //   Admin: leitura total + escrita.
    // ─────────────────────────────────────────────────────────
    match /books/{bookId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // SITE — documentos de conteúdo editável no /admin
    //   (hoje: `currently`, os cards "O que tá rolando" da /sobre)
    //   Leitura pública: é conteúdo do site.
    //   Escrita: só admin.
    // ─────────────────────────────────────────────────────────
    match /site/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /playing/{docId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // FIGMA — arquivos da Community mostrados em /figma
    //   Cadastro manual: o Figma não expõe API de perfil da Community.
    //   Leitura pública: só itens com `visible == true`.
    //   Admin: leitura total + escrita.
    // ─────────────────────────────────────────────────────────
    match /figma/{docId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // USES — categorias do setup mostradas em /uses
    //   Leitura pública: só categorias com `visible == true`.
    //   Admin: leitura total + escrita.
    // ─────────────────────────────────────────────────────────
    match /uses/{docId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // GUESTBOOK
    //   Leitura pública: qualquer um vê todas mensagens.
    //   Escrita: user autenticado pode criar/editar/deletar SÓ a própria
    //     entrada (docId === auth.uid).
    //   Admin: pode deletar qualquer entrada (moderação de spam).
    //   Validação: message não vazia, máx 280 chars.
    // ─────────────────────────────────────────────────────────
    match /guestbook/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 280;
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);
    }

    // ═════════════════════════════════════════════════════════════════════════
    // SITE DA KEYLLA (SEC-01)
    //
    // O site não tem servidor próprio nem `firebase-admin` (AD-001): a leitura
    // pública e a escrita da autora saem do mesmo SDK, no navegador. Quem
    // autoriza é este arquivo — código de aplicação aqui não protege nada.
    // ═════════════════════════════════════════════════════════════════════════

    // A allowlist mora NAS REGRAS, nunca em campo de documento: a autora tem
    // escrita na coleção e poderia promover a si mesma se o papel morasse no
    // banco. Para adicionar alguém, basta mais um uid nesta lista.
    //
    // `tests/rules/firestore.rules.test.ts` lê os uids DESTA lista por texto,
    // esperando aspas simples — mantenha o formato ao editar.
    function autoras() {
      return [
        'COLE_AQUI_O_UID_DA_KEYLLA',
        'm9GLhNQbNZRbwFT3l6M8XiJSIpF3'
      ];
    }

    function ehAutora() {
      return request.auth != null && request.auth.uid in autoras();
    }

    match /publicacoes/{publicacaoId} {
      // Leitura de um documento pelo id. O painel abre o formulário por id e
      // precisa enxergar rascunho; visitante só alcança o que está no ar.
      allow get: if ehAutora() || resource.data.publicado == true;

      // Leitura de lista. A regra é avaliada contra a CONSULTA, não contra o
      // que ela devolveria: uma consulta sem `where('publicado', '==', true)`
      // é recusada inteira para quem não é a autora, mesmo que por acaso só
      // fosse casar com documentos publicados.
      //
      // Passa anônima:   where('publicado','==',true) + orderBy('publicadoEm')
      //                  (home) e where('slug') + where('publicado','==',true)
      //                  (detalhe).
      // Passa só autenticada: a listagem do painel, que traz a coleção inteira
      //                  para mostrar rascunho, e a conferência de slug
      //                  duplicado, que filtra apenas por `slug`.
      allow list: if ehAutora() || resource.data.publicado == true;

      allow create, update, delete: if ehAutora();
    }

    match /formacoes/{formacaoId} {
      // Formação não tem rascunho: o que está cadastrado está na página.
      allow read: if true;
      allow create, update, delete: if ehAutora();
    }

    // Default: nega tudo (defense in depth).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
